# === Worklog Dashboard environment ===
# 1) Copy this file to `.env`:   cp .env.example .env
# 2) Generate a Fernet encryption key and put it in WORKLOG_ENC_KEY:
#      docker run --rm python:3.12-slim python -c \
#        "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#    or locally:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Secret used to encrypt Jira credentials at rest. MUST be set — no default.
WORKLOG_ENC_KEY=

# How often the background sync pulls worklogs (minutes). 0 disables the scheduler.
SYNC_INTERVAL_MINUTES=60

# Allowed CORS origin for the built frontend. In Docker the UI is served on its
# own origin and proxies /api internally, so the default is fine.
CORS_ORIGINS=http://localhost:8080

# Host port the web UI is published on.
APP_PORT=8080
